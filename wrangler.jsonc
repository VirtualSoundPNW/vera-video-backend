{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "vera-video-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-16",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vera-video",
			// Replace with the id printed by: wrangler d1 create vera-video
			"database_id": "0b723c5f-6da9-454f-9973-54530e52963d",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		// Two schedules, distinguished by controller.cron in src/index.ts:
		//  - discovery runs hourly (cut from every 20 min — new videos are rare
		//    enough that 3x less frequent checking is plenty), crawling
		//    rotating sources until it spends DISCOVERY_QUOTA_TARGET or hits
		//    the per-invocation source cap
		//  - refresh runs nightly and re-checks a batch of the stalest videos
		"crons": [
			"0 * * * *",
			"45 3 * * *"
		]
	},
	"vars": {
		// Max videos.list ids re-checked per refresh run (YouTube caps at 50/call).
		"REFRESH_BATCH_SIZE": "50",
		// Max results requested per discovery page (YouTube caps at 50).
		"DISCOVERY_PAGE_SIZE": "50",
		// Keep score threshold for the relevance filter. See src/filter.ts.
		"RELEVANCE_THRESHOLD": "3",
		// Discovery keeps crawling sources within one run until spent quota
		// reaches this (or the MAX_SOURCES_PER_RUN safety cap in crawler.ts).
		// 110 lets a run pack one search (~101) plus 3 cheap channel fills
		// (~107 total) instead of stopping right after the search; any value
		// above ~107 behaves the same because the source cap kicks in first.
		"DISCOVERY_QUOTA_TARGET": "110",
		// Each search source is re-crawled at most once per this interval;
		// runs where no search is due go entirely to cheap channel sources.
		// 420 min x 7 enabled searches = 24 search runs/day, matching the
		// hourly cron's 24 invocations/day: every run carries one search plus
		// channel fills, 24 x ~107 ~= 2,570 units/day (~26% of the 10,000
		// cap). Raise this to spend less.
		"SEARCH_INTERVAL_MINUTES": "420",
		// A channel with at least this many filter-accepted videos is
		// auto-added as a channel_uploads source (its policy stays neutral —
		// uploads are still filtered). 1 promotes one-hit channels too, which
		// roughly triples the pool and stretches the revisit cadence.
		"AUTO_PROMOTE_MIN_ACTIVE": "2"
	}
	// Secret (set with `wrangler secret put YOUTUBE_API_KEY`, never committed):
	//   YOUTUBE_API_KEY - YouTube Data API v3 key, restricted to this Worker.
}